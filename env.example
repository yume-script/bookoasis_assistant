# BookOasis 보조 프로그램 (독립형) 설정 - 웹툰 다운로더 (+ 드라이브 변경 감시 · 미니게임)
# cp env.example .env 후 값을 채운다. .env는 git에 커밋되지 않는다 (.gitignore).
# 실제 환경변수(docker -e / systemd Environment=)가 있으면 그 값이 .env보다 우선한다.
# 관리 화면의 [감시 설정 > 실행 환경 저장]은 이 파일의 RCLONE_* / BOOKOASIS_URL / WEBHOOK_TOKEN / AUTO_START 줄만 바꾼다.

# ── 모듈 ──
WTM_ENABLED=true          # 웹툰 다운로더 (기본 모듈 - 첫 화면)
GDW_ENABLED=true          # 드라이브 변경 감시 (rclone 마운트를 BookOasis에 바로 스캔시킬 때)
#                           리눅스 전용 - 윈도우에서는 비워 두면 꺼짐 (false로 적어 두면 경고도 안 나옴)
MINI_ENABLED=true         # 미니게임 아케이드 (브라우저에서만 도는 게임, 서버 부하 없음)

# ── 관리 화면 ──
# 로그인은 YMPlayer와 같은 로그인 화면 + 세션 쿠키. 계정은 DATA_DIR/users.json (설정 > 사용자에서 추가·삭제·비밀번호 변경)
WEB_HOST=127.0.0.1
WEB_PORT=5931
# 첫 관리자 계정: 사용자가 하나도 없을 때 한 번만 이 값으로 만든다 (그 뒤 비밀번호는 화면에서 바꾸고, 여기 값은 지워도 됨)
# 둘 다 비우면 첫 접속 화면에서 '관리자 계정 만들기'. 단 0.0.0.0 등 외부 주소로 열 때는 계정이 없으면 시작하지 않는다
WEB_USER=admin
WEB_PASSWORD=
# 계정이 없어도 외부 주소로 시작 허용 (처음 연 사람이 관리자를 만들 수 있으니 안전한 망에서만)
WEB_ALLOW_NO_AUTH=false
# MCP 서버 (POST /mcp, Authorization: Bearer 이 값). 비우면 꺼짐. 관리 화면 설정 > MCP에서 만들고 지우는 것을 권장
MCP_TOKEN=

# ── 데이터 ──
# state.db, worker.log, watch.json(감시 폴더·처리 옵션), runtime.json 등. 상대 경로는 이 폴더 기준.
# 플러그인에서 옮겨 올 때는 plugins/data/gdrive_watch/ 내용을 이 폴더에 그대로 복사하면 기록·체크포인트가 이어진다.
DATA_DIR=data
LOG_LEVEL=INFO

# ── rclone ──
RCLONE_PATH=rclone
# 비우면 rclone 기본 위치. 도커라면 파일이 아니라 디렉터리째 마운트할 것
RCLONE_CONFIG=

# ── BookOasis 스캔 요청 ──
# 이 프로그램에서 접속할 수 있는 BookOasis 주소
BOOKOASIS_URL=http://127.0.0.1:5930
# BookOasis .env의 WEBHOOK_TOKEN과 같은 값
WEBHOOK_TOKEN=

# ── 감시 자동 시작 ──
# 이 프로그램이 시작될 때 워커도 시작하고, 워커가 죽으면 다시 띄운다 ([중지]를 누르면 다시 띄우지 않음)
AUTO_START=true

# ── 보관함 목록 (둘 중 하나) ──
# 1) BookOasis DB 직접 연결: 보관함 목록·RC 주소·전체 스캔 일정 자동 + 반영 확인 + 이미 등록된 파일 건너뛰기
#    {db_type}은 아래 BOOKOASIS_DB_TYPES의 각 값으로 바뀐다. MariaDB/MySQL은 mysql://, SQLite는 sqlite:////절대/경로
#    비밀번호에 특수문자가 있으면 URL 인코딩 (@ → %40, : → %3A, / → %2F)
#    예) BOOKOASIS_DB_URL=mysql://bookoasis:비밀번호@192.168.0.31:3306/bookoasis_{db_type}
BOOKOASIS_DB_URL=
BOOKOASIS_DB_TYPES=general,adult,audiobook,video
# 세션마다 DB가 다르게 생겼으면 따로 지정 (지정한 값이 BOOKOASIS_DB_URL보다 우선)
# BOOKOASIS_DB_URL_GENERAL=
# BOOKOASIS_DB_URL_ADULT=
# BOOKOASIS_DB_URL_AUDIOBOOK=
# BOOKOASIS_DB_URL_VIDEO=
#
# 2) DB 없이: 보관함을 JSON 파일로 직접 적는다 (libraries.example.json 참고). 비우면 DATA_DIR/libraries.manual.json
LIBRARIES_FILE=

# ── 웹툰 다운로더 (WTM_ENABLED=true일 때) ──
# 데이터 폴더(titles.json, 이력, 로그, settings.json 등). 비우면 DATA_DIR/webtoon
# 플러그인에서 옮길 때는 plugins/data/webtoon_manager/ 내용을 이 폴더에 복사 (첫 실행 때 worker_cfg.json의 설정을 자동으로 가져옴)
WTM_DATA_DIR=
# 받은 회차를 드라이브 변경 감시에 바로 넘겨 VFS 새로고침 → BookOasis 부분 스캔 (Drive 변경 감지를 기다리지 않음)
WTM_HANDOFF_GDW=true
# 넘긴 회차를 모으지 않고 바로 스캔 (받자마자 BookOasis 등록·메타데이터). false면 폴더가 조용해질 때까지 모아서 한 번에
WTM_SCAN_IMMEDIATE=true
# 아래 값은 관리 화면 [웹툰 다운로더 > 설정]에서 저장해도 여기에 써진다. 나머지 운영 옵션(구독·속도 등)은 WTM_DATA_DIR/settings.json
# 저장 경로 (비우면 데이터 폴더 아래). BookOasis 보관함 경로와 같은 경로로 보여야 스캔 연결이 된다
WTM_DOWNLOAD_ROOT=
WTM_KAKAO_DOWNLOAD_ROOT=
WTM_KAKAO_NOVEL_DOWNLOAD_ROOT=
# 압축 전 임시 작업 폴더 (저장 경로가 rclone 마운트면 반드시 로컬 디스크)
WTM_TEMP_DOWNLOAD_ROOT=
# 로그인 쿠키: 화면에서 저장하면 WTM_DATA_DIR/cookies/의 파일(naver.json, kakao_1~5.json)로 저장된다. 아래 값은 그 파일이 없을 때만 쓰임
WTM_NAVER_COOKIE_JSON=
WTM_KAKAO_COOKIE=
# 카카오 추가 계정 쿠키 (계정 1로 받은 뒤 남은 유료 회차를 이 계정들로 다시 시도). 화면 [카카오웹툰 > 추가 계정]에서 넣는 것을 권장
WTM_KAKAO_COOKIE_2=
WTM_KAKAO_COOKIE_3=
WTM_KAKAO_COOKIE_4=
WTM_KAKAO_COOKIE_5=
# 알림 (새 회차·완결·쿠키 만료·실패 요약)
WTM_DISCORD_WEBHOOK_URL=
WTM_DISCORD_BOT_TOKEN=
WTM_DISCORD_CHANNEL_ID=
WTM_NOTIFY_TELEGRAM_BOT_TOKEN=
WTM_NOTIFY_TELEGRAM_CHAT_ID=
WTM_NOTIFY_SLACK_WEBHOOK_URL=
WTM_NOTIFY_NTFY_URL=
WTM_NOTIFY_NTFY_TOKEN=
# 고른 작품의 회차 파일을 텔레그램 채널에 올리기 (작품 카드의 📤 텔레그램 버튼으로 작품마다 켬)
# 채널 ID(-100…) 또는 @채널이름. 봇을 채널 관리자로 추가할 것. 개인 보관용 비공개 채널만
WTM_TELEGRAM_UPLOAD_CHAT_ID=
# 비우면 WTM_NOTIFY_TELEGRAM_BOT_TOKEN
WTM_TELEGRAM_UPLOAD_BOT_TOKEN=
# 비우면 https://api.telegram.org (파일당 50MB). 로컬 Bot API 서버(최대 2GB)를 쓸 때만 그 주소
WTM_TELEGRAM_UPLOAD_API_URL=

# ── 미니게임 (MINI_ENABLED=true일 때) ──
# 그림 땅따먹기 표지 그림 폴더 (jpg/png/gif/webp). 비우면 mini/games/picture-territory/covers
MINI_COVERS_DIR=
