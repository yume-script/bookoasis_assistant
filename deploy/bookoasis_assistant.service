# /etc/systemd/system/bookoasis_assistant.service
# 경로·User는 환경에 맞게 바꾼다. rclone 마운트와 BookOasis 보관함 경로가 이 서버에서 같은 경로로 보여야 한다.
[Unit]
Description=BookOasis Assistant (drive watcher · webtoon downloader · mini games)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bookoasis_assistant
ExecStart=/opt/bookoasis_assistant/venv/bin/python /opt/bookoasis_assistant/app.py
Restart=on-failure
RestartSec=10
# 워커가 진행 중인 스캔 요청을 마칠 시간
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
